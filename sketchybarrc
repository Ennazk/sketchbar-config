#!/bin/bash

source "$CONFIG_DIR/colors.sh"

PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Bar Appearance #####
sketchybar --bar height=37        \
                 blur_radius=50   \
                 position=top     \
                 sticky=off       \
                 y_offset=-5      \
                 margin=0         \
                 padding_left=4   \
                 padding_right=4  \
                 color=$BAR_COLOR \
                 shadow=off

##### Changing Defaults #####
sketchybar --default icon.font="JetBrainsMono Nerd Font:Bold:15.0" \
                     icon.color=$WHITE                    \
                     label.font="JetBrainsMono Nerd Font:Bold:15.0" \
                     label.color=$WHITE                   \
                     background.drawing=off               \
                     background.color=$ITEM_BG_COLOR      \
                     background.corner_radius=8           \
                     background.height=26                 \
                     padding_left=2                       \
                     padding_right=2                      \
                     label.padding_left=4                 \
                     label.padding_right=4                \
                     icon.padding_left=4                  \
                     icon.padding_right=2

##### Adding Left Items #####
source $ITEM_DIR/apple_logo.sh
source $ITEM_DIR/hyprmac_spaces.sh
source $ITEM_DIR/separator_left.sh
source $ITEM_DIR/front_app.sh
source $ITEM_DIR/media.sh

##### Adding Right Items #####
source $ITEM_DIR/right_items.sh

##### Finalizing Setup #####
sketchybar --update
